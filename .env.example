# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
DJANGO_SECRET_KEY=gere-uma-chave-longa-aleatoria
DJANGO_DEBUG=true
# Produção: DJANGO_DEBUG=false. Hosts/CSRF já aceitam *.vercel.app por padrão; para domínio próprio:
# DJANGO_ALLOWED_HOSTS=meudominio.com.br,.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meudominio.com.br,https://*.vercel.app
# PostgreSQL. Deixe vazio/comentado para usar SQLite local.
# Local:     DATABASE_URL=postgres://localhost/chatbot_atendimento
# Produção:  a integração Neon da Vercel cria DATABASE_URL sozinha (POSTGRES_URL também é aceita).
#            Em produção (DJANGO_DEBUG=false ou na Vercel) o settings exige sslmode=require.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
TELEGRAM_BOT_TOKEN=token-do-BotFather
TELEGRAM_BOT_USERNAME=felipeprojeto_bot
TELEGRAM_WEBHOOK_SECRET=um-segredo-qualquer
GEMINI_API_KEY=chave-do-aistudio.google.com
GEMINI_MODEL=gemini-flash-lite-latest
NOME_EMPRESA=Empresa Teste
