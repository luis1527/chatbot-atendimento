=1.4;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=11;endSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="64" y="1024" as="sourcePoint"/><mxPoint x="144" y="1024" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg_ex0_t" value="&lt;b&gt;exatamente 1&lt;/b&gt; → 0..N &amp;nbsp;&lt;span style='color:#7B8794'&gt;FK obrigatória (NOT NULL)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="1015" width="386" height="18" as="geometry"/></mxCell><mxCell id="leg_ex1" value="" style="edgeStyle=none;html=1;strokeColor=#4A5563;strokeWidth=1.4;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=11;endSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="64" y="1054" as="sourcePoint"/><mxPoint x="144" y="1054" as="targetPoint"/></mxGeometry></mxCell><mxCell id="leg_ex1_t" value="&lt;b&gt;0 ou 1&lt;/b&gt; → 0..N &amp;nbsp;&lt;span style='color:#7B8794'&gt;FK opcional (aceita NULL)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="1045" width="386" height="18" as="geometry"/></mxCell><mxCell id="leg_ex_nota" value="O traço sai da tabela-pai (lado “um”) e o pé-de-galinha entra na linha da coluna FK da tabela-filha. O verbo se lê do pai para o filho: &lt;i&gt;sala possui chave&lt;/i&gt;, &lt;i&gt;usuário retira empréstimo&lt;/i&gt;." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="1074" width="482" height="32" as="geometry"/></mxCell><mxCell id="leg_m0" value="PK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#9A6B00;fillColor=#FFF6D6;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="64" y="1118" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_m0_t" value="chave primária (linha destacada)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="106" y="1118" width="200" height="19" as="geometry"/></mxCell><mxCell id="leg_m1" value="FK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="314" y="1118" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_m1_t" value="chave estrangeira (sublinhada)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="356" y="1118" width="200" height="19" as="geometry"/></mxCell><mxCell id="leg_m2" value="UQ" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="64" y="1143" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_m2_t" value="valor único" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="106" y="1143" width="200" height="19" as="geometry"/></mxCell><mxCell id="leg_m3" value="NN" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="314" y="1143" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_m3_t" value="obrigatório (NOT NULL)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="356" y="1143" width="200" height="19" as="geometry"/></mxCell><mxCell id="leg_m4" value="CK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="64" y="1168" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_m4_t" value="regra CHECK" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="106" y="1168" width="200" height="19" as="geometry"/></mxCell><mxCell id="leg_m5" value="UQ¹" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="314" y="1168" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_m5_t" value="unicidade parcial (ver regras)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="356" y="1168" width="200" height="19" as="geometry"/></mxCell><mxCell id="leg_tipos" value="Tipos PostgreSQL gerados pelo Django · timestamptz = timestamp with time zone" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=10;fontColor=#7B8794;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="1198" width="482" height="16" as="geometry"/></mxCell><mxCell id="leg_regras" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;fillColor=#FAFBFC;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="590" y="966" width="1030" height="262" as="geometry"/></mxCell><mxCell id="leg_regras_tit" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Regras de integridade no banco&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="614" y="982" width="400" height="20" as="geometry"/></mxCell><mxCell id="leg_r0" value="UQ¹" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="614" y="1014" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_r0_t" value="&lt;b&gt;uma chave só tem UM empréstimo em aberto&lt;/b&gt;: UNIQUE (chave_id) WHERE devolvido_em IS NULL" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="658" y="1014" width="938" height="19" as="geometry"/></mxCell><mxCell id="leg_r1" value="CK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="614" y="1039" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_r1_t" value="&lt;b&gt;empréstimo&lt;/b&gt;: devolucao_prevista &amp;gt; retirada_em; devolvido_em vazio ou ≥ retirada_em" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="658" y="1039" width="938" height="19" as="geometry"/></mxCell><mxCell id="leg_r2" value="CK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="614" y="1064" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_r2_t" value="&lt;b&gt;empréstimo&lt;/b&gt;: devolvido_em e recebido_por_id são preenchidos juntos (ou ficam os dois vazios)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="658" y="1064" width="938" height="19" as="geometry"/></mxCell><mxCell id="leg_r3" value="CK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="614" y="1089" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_r3_t" value="&lt;b&gt;movimentação&lt;/b&gt;: tipo 'retirada' ou 'devolucao' exige emprestimo_id e usuario_id" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="658" y="1089" width="938" height="19" as="geometry"/></mxCell><mxCell id="leg_r4" value="CK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="614" y="1114" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_r4_t" value="&lt;b&gt;valores válidos&lt;/b&gt;: chave.status, usuario.tipo e movimentacao.tipo só aceitam a lista definida" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="658" y="1114" width="938" height="19" as="geometry"/></mxCell><mxCell id="leg_r5" value="CK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="614" y="1139" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_r5_t" value="&lt;b&gt;sala&lt;/b&gt;: capacidade vazia ou maior que zero" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="658" y="1139" width="938" height="19" as="geometry"/></mxCell><mxCell id="leg_r6" value="UQ" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="614" y="1164" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_r6_t" value="&lt;b&gt;sem duplicidade&lt;/b&gt;: sala.codigo, chave.codigo e usuario.matricula" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="658" y="1164" width="938" height="19" as="geometry"/></mxCell><mxCell id="leg_r7" value="FK" style="rounded=1;arcSize=20;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#52606D;fillColor=#FFFFFF;strokeColor=#D9DEE4;" vertex="1" parent="1"><mxGeometry x="614" y="1189" width="34" height="19" as="geometry"/></mxCell><mxCell id="leg_r7_t" value="&lt;b&gt;ON DELETE PROTECT em todas as FKs&lt;/b&gt;: nada é apagado em cascata, o histórico fica preservado" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=11;fontColor=#52606D;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="658" y="1189" width="938" height="19" as="geometry"/></mxCell></root>
